# Kellyfin server as this machine reaches it, and the worker token from Kellyfin: Settings -> Narration.
KELLYFIN_URL=http://192.168.1.10:8024
KELLYFIN_NARRATOR_TOKEN=
# Videos worked on at once (default 3); OCR, Whisper, translation and VieNeu still take one video at a time each.
#WORKER_JOBS=3
# CPU setup (docker-compose.cpu.yml) only: Whisper model, medium (default) or small (about 2.5x faster, a little less exact).
#WHISPER_MODEL=medium
