{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kellyfin",
  "version": "2.19.4",
  "identifier": "com.koi.kellyfin",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kellyfin",
        "width": 1280,
        "height": 800,
        "minWidth": 360,
        "minHeight": 480,
        "backgroundColor": "#0b0d12"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src * blob: data:; media-src * blob: data:; connect-src * tauri: ipc: capacitor: ionic: blob: data: ws: wss:; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM3QzkxOEVBQjFENzgwNDQKUldSRWdOZXg2aGpKeDIzbXc5R2cyRzRFRVF2emY4UWNpTDkzRk9tTHQ0OUJvdUZGNDRQWDl2R0sK",
      "endpoints": [
        "https://github.com/datlt4/Kellyfin/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
